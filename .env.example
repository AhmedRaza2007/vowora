# =============================================================================
# VOWORA — Environment Variables (EXAMPLE ONLY — no real secrets)
# Copy to .env.local and fill in. NEVER commit real keys. See docs/system-architecture.md §7.
# =============================================================================

# --- Supabase (REQUIRED to run against a live database) -----------------------
# Create a project at https://supabase.com, then copy these from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=
# Used by Supabase CLI / migrations only.
DATABASE_URL=

# --- Application -------------------------------------------------------------
# Canonical public URL (used for invitation links + Open Graph images).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (PENDING — optional until configured) -----------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- Payments (PENDING — verify provider/merchant eligibility first) ----------
# Supported values: manual | stripe  (Pakistan-compatible providers added after verification)
PAYMENTS_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AI Assistant (PENDING — server-side only) -------------------------------
# Supported values: openai-compatible | anthropic
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# --- Google Maps (PENDING — optional) ----------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Analytics (PENDING — optional) ------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Rate limiting (optional; Upstash Redis for production) ------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=